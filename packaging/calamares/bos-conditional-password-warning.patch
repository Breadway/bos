+static bool
+isLuksEncryptionEnabled()
+{
+    auto* jobQueue = Calamares::JobQueue::instance();
+    auto* globalStorage = jobQueue ? jobQueue->globalStorage() : nullptr;
+    if ( !globalStorage || !globalStorage->contains( "luksPassphrase" ) )
+    {
+        return false;
+    }
+
+    // The partition view stores an obfuscated passphrase when encryption is
+    // selected. Only check whether it is present. Do not decode or expose it.
+    return !globalStorage->value( "luksPassphrase" ).toString().isEmpty();
+}
