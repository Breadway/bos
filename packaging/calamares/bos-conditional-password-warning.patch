+void
+UserTests::testEncryptedPasswordAdvisory()
+{
+    if ( !Calamares::JobQueue::instance() )
+    {
+        (void)new Calamares::JobQueue( nullptr );
+    }
+    auto* globalStorage = Calamares::JobQueue::instance()->globalStorage();
+    QVERIFY( globalStorage );
+
+    const bool hadLuksPassphrase = globalStorage->contains( "luksPassphrase" );
+    const QVariant oldLuksPassphrase = globalStorage->value( "luksPassphrase" );
+    struct RestoreLuksPassphrase
+    {
+        Calamares::GlobalStorage* storage;
+        bool hadValue;
+        QVariant value;
+
+        ~RestoreLuksPassphrase()
+        {
+            if ( hadValue )
+            {
+                storage->insert( "luksPassphrase", value );
+            }
+            else
+            {
+                storage->remove( "luksPassphrase" );
+            }
+        }
+    } restore { globalStorage, hadLuksPassphrase, oldLuksPassphrase };
+    globalStorage->remove( "luksPassphrase" );
+
+    QVariantMap configuration;
+    configuration.insert( "defaultGroups", QStringList { "users" } );
+    QVariantMap passwordRequirements;
+    passwordRequirements.insert( "minLength", 8 );
+    configuration.insert( "passwordRequirements", passwordRequirements );
+
+    Config config;
+    config.setConfigurationMap( configuration );
+    config.setFullName( "Bread User" );
+    config.setLoginName( "breaduser" );
+    config.setUserPassword( "eight888" );
+    config.setUserPasswordSecondary( "eight888" );
+
+    QCOMPARE( config.userPasswordValidity(), Config::PasswordValidity::Valid );
+    QCOMPARE( config.userPasswordMessage(), QStringLiteral( "OK!" ) );
+
+    globalStorage->insert( "luksPassphrase", QStringLiteral( "obfuscated-test-value" ) );
+    QSignalSpy statusSpy( &config, &Config::userPasswordStatusChanged );
+    config.setUserPassword( "eight999" );
+    config.setUserPasswordSecondary( "eight999" );
+    QCOMPARE( config.userPasswordValidity(), Config::PasswordValidity::Weak );
+    QVERIFY( config.userPasswordMessage().contains( QStringLiteral( "12 characters" ) ) );
+    QVERIFY( statusSpy.last().at( 1 ).toString().contains( QStringLiteral( "12 characters" ) ) );
+    QVERIFY( config.isReady() );
+
+    config.setUserPassword( "passWORD1234" );
+    config.setUserPasswordSecondary( "passWORD1234" );
+    QCOMPARE( config.userPasswordValidity(), Config::PasswordValidity::Valid );
+    QCOMPARE( config.userPasswordMessage(), QStringLiteral( "OK!" ) );
+    QCOMPARE( statusSpy.last().at( 1 ).toString(), QStringLiteral( "OK!" ) );
+}
