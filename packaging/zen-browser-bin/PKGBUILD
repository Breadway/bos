# In-house copy of the AUR zen-browser-bin package, published to [breadway].
# The six-hour release watcher can override pkgver and the release archive
# checksum for a newer upstream stable release without skipping integrity checks.
pkgname=zen-browser-bin
pkgver=${ZEN_PKGVER:-1.22.3b}
pkgrel=1
pkgdesc="Official package for Zen, a privacy-focused Firefox-based web browser"
arch=('x86_64')
url="https://github.com/zen-browser/desktop"
license=('MPL-2.0')
depends=(gtk3 libxt mime-types dbus-glib nss ttf-font systemd ffmpeg)
optdepends=(
  'networkmanager: Location detection via available WiFi networks'
  'libnotify: Notification integration'
  'pulse-native-provider: Audio support'
  'speech-dispatcher: Text-to-Speech'
  'hunspell-en_US: Spell checking, American English'
)
options=(!strip)
provides=("zen-browser=$pkgver")
conflicts=('zen-browser')

source=(
  "zen-browser-$pkgver-$pkgrel-x86_64.tar.xz::https://github.com/zen-browser/desktop/releases/download/$pkgver/zen.linux-x86_64.tar.xz"
  'zen-browser.sh'
  'zen-browser.desktop'
  'policies.json'
)
sha256sums=(
  "${ZEN_SHA256:-0aaee1b3f67f074aebf7fc6c2fe824441bcafd431e9991336479c16370519dd0}"
  '9a95313a25345e2e46a99684c6fcd2fbc811366348354a78ee5b07982483df5f'
  '1e30b9521b92429c56cab185e80287edfbd5488ec8b8a638efaff58f45349e79'
  'e977c3d690224dd727d8761d2c0a66ba41bfd02ae0fd7850c4545d06b5a8e63c'
)

package() {
  install -d "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  cp -r "$srcdir/zen/." "$pkgdir/opt/$pkgname/"
  install -Dm755 "$srcdir/zen-browser.sh" "$pkgdir/usr/bin/zen-browser"
  install -Dm644 "$srcdir/zen-browser.desktop" "$pkgdir/usr/share/applications/zen-browser.desktop"

  for size in 16 32 48 64 128; do
    install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    ln -s "/opt/$pkgname/browser/chrome/icons/default/default${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/zen-browser.png"
  done

  ln -Ts /usr/share/hunspell "$pkgdir/opt/$pkgname/dictionaries"
  ln -Ts /usr/share/hyphen "$pkgdir/opt/$pkgname/hyphenation"
  ln -sf /usr/lib/libnssckbi.so "$pkgdir/opt/$pkgname/libnssckbi.so"
  install -Dm644 "$srcdir/policies.json" "$pkgdir/opt/$pkgname/distribution/policies.json"
}
