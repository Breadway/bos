#!/bin/bash
# bos-update: update all of BOS in one go.
#
# BOS packages come from two channels, so a full update touches both:
#   1. pacman   : Arch base/desktop + the [breadway] repo (breadlock + AUR
#                 republishes: calamares, zen-browser-bin, bibata, yay-bin,
#                 powerlevel10k). [breadway] does NOT provide bos-settings
#                 or other bakery desktop apps. Every transaction is
#                 snapshotted by snap-pac; recover via the GRUB "snapshots"
#                 submenu (grub-btrfs), not `snapper rollback`.
#   2. bakery   : the bread ecosystem apps in /usr/local (whatever `bakery list`
#                 reports as installed: bakery, bread, breadbar, breadbox,
#                 breadcrumbs, breadpad, breadman, bread-theme, breadpaper,
#                 breadclip, breadshot, bos-settings,
#                 breadhelp, ...). Those bits live on @ and ride snapper
#                 root snapshots; recover via grub-btrfs, not `snapper rollback`.
#
# Best-effort: a failure in one channel doesn't abort the other.
set -uo pipefail

bold() { printf '\033[1m%s\033[0m\n' "$1"; }

# New bakery handles snapshots itself, including direct/GUI transactions.
# Keep a numbered pre/post fallback for the bakery shipped on older installs.
SNAPSHOT_CONFIGS=()
SNAPSHOT_NUMBERS=()
ELEVATE=()
close_snapshots() {
    local outcome="$1" i
    for i in "${!SNAPSHOT_CONFIGS[@]}"; do
        "${ELEVATE[@]}" snapper -c "${SNAPSHOT_CONFIGS[$i]}" create -t post \
            --pre-number "${SNAPSHOT_NUMBERS[$i]}" -c number \
            -d "bos-update bakery (post, $outcome)" \
            || echo "WARN: snapper ${SNAPSHOT_CONFIGS[$i]} post snapshot failed"
    done
    SNAPSHOT_CONFIGS=()
    SNAPSHOT_NUMBERS=()
}
open_snapshots() {
    local config number
    command -v snapper >/dev/null || return 0
    for config in root home; do
        # Home is optional, not all BOS installs create a home config.
        "${ELEVATE[@]}" snapper -c "$config" list >/dev/null 2>&1 || continue
        if number=$("${ELEVATE[@]}" snapper -c "$config" create -t pre -p -c number \
                -d "bos-update bakery (pre)"); then
            if [[ "$number" =~ ^[1-9][0-9]*$ ]]; then
                SNAPSHOT_CONFIGS+=("$config")
                SNAPSHOT_NUMBERS+=("$number")
            else
                echo "WARN: snapper $config did not return a valid pre snapshot number"
            fi
        else
            echo "WARN: snapper $config pre snapshot failed"
        fi
    done
}

bold "==> System packages (pacman -Syu)"
if command -v pacman >/dev/null; then
    sudo pacman -Syu || echo "WARN: pacman update failed"
else
    echo "pacman not found; skipping"
fi

echo
bold "==> Bread ecosystem (bakery update --all)"
if command -v bakery >/dev/null; then
    # Use the same privilege path for snapshots and package writes.
    if sudo -n true >/dev/null 2>&1; then
        ELEVATE=(sudo -n)
    elif command -v pkexec >/dev/null; then
        ELEVATE=(pkexec)
    else
        echo "WARN: bakery update needs sudo -n or pkexec for /usr/local"
    fi
    if ((${#ELEVATE[@]})); then
        if ! "${ELEVATE[@]}" bakery capabilities 2>/dev/null | grep -qx 'snapper-transactions-configured-v1'; then
            trap 'close_snapshots interrupted' EXIT
            open_snapshots
        fi
        if "${ELEVATE[@]}" bakery update --all; then
            close_snapshots success
        else
            close_snapshots failed
            echo "WARN: bakery update failed"
        fi
        trap - EXIT
    fi
else
    echo "bakery not found; skipping"
fi

echo
bold "==> BOS is up to date."
echo
bold "Recovery"
echo "If this update goes badly: reboot → GRUB “snapshots” submenu."
echo "snapper rollback will not change what GRUB boots (rootflags=subvol=@)."
echo "Snapshot boots use a temporary writable overlay. To make one permanent, boot it and run: sudo bos-restore-snapshot <number>"
